# One origin for the browser, so session cookies stay same-site (D-008).
:8080 {
	encode zstd gzip

	handle /api/v1/tiles/* {
		uri strip_prefix /api/v1/tiles
		reverse_proxy martin:3000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Self-hosted basemap (D-005, `make basemap`): PMTiles are read with range requests.
	handle_path /basemap/* {
		root * /srv/basemap
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
}
