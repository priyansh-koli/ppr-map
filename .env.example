# Copy to .env (never commit .env). `make env` does this and fills the secrets for you.
# Every variable used anywhere is listed here; see docs/external-services.md.

# --- app ---------------------------------------------------------------------------------------
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8080
# 64+ random chars
SESSION_SECRET=
# 64+ random chars
CSRF_SECRET=
# 32+ random chars
IP_HASH_SALT=

# --- database / cache (docker compose) ---------------------------------------------------------
POSTGRES_USER=pprmap
# any local password
POSTGRES_PASSWORD=
POSTGRES_DB=pprmap
# Host-side URLs, for running the API, pipeline or tests outside Docker:
DATABASE_URL=postgresql+psycopg://pprmap:CHANGE_ME@localhost:5432/pprmap
TEST_DATABASE_URL=postgresql+psycopg://pprmap:CHANGE_ME@localhost:5432/pprmap_test
REDIS_URL=redis://localhost:6379/0

# --- jobs (D-051) -------------------------------------------------------------------------------
# true in production: the scheduler queues the monthly pipeline (downloads the register and
# needs the geocoder). Alerts and daily housekeeping are always scheduled.
SCHEDULE_PIPELINE=false

# --- email (dev: Mailpit catches everything at http://localhost:8025) ---------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="PPR Map <no-reply@localhost>"

# --- data sources (defaults live in config/sources.yaml; override only if they move) -----------
PPR_DOWNLOAD_URL=
GTFS_URL=
OSM_EXTRACT_URL=
PLANNING_FEATURESERVER_URL=
GZT_DEV_PLAN_URL=
GZT_LAP_URL=
CSO_PXSTAT_BASE=
POBAL_URL=
BOUNDARIES_BASE_URL=
SCHOOLS_PRIMARY_URL=
SCHOOLS_POST_PRIMARY_URL=
EPA_RADON_URL=
EPA_NOISE_URL=
TAILTE_VALUATION_API_URL=
SEAI_BER_EXPORT_PATH=

# --- geocoder (self-hosted Nominatim, `--profile geocoder`) ------------------------------------
NOMINATIM_URL=http://localhost:8088
NOMINATIM_PASSWORD=

# --- pipeline paths (optional; the Docker image sets both) ---------------------------------------
# where downloads land, default ./data
# DATA_DIR=
# folder holding sources.yaml, default ./config in the repo
# PPR_CONFIG_DIR=

# --- frontend build ------------------------------------------------------------------------------
# `npm run dev` proxies /api here, default http://localhost:8000 (the Docker image uses http://api:8000)
# INTERNAL_API_ORIGIN=
# STATIC_EXPORT=1 and PAGES_BASE_PATH are set by .github/workflows/pages.yml for the Pages preview

# --- map ---------------------------------------------------------------------------------------
NEXT_PUBLIC_BASEMAP_PMTILES_URL=
# optional, dev only; ask before signing up
NEXT_PUBLIC_MAPTILER_KEY=

# --- not chosen yet (ask before adding any paid service) ---------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
EIRCODE_PROVIDER=
EIRCODE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
